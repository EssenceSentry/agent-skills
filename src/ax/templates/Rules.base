filters:
  and:
    - file.inFolder("Profile/rules")
properties:
  file.name:
    displayName: Rule id
  rule:
    displayName: Rule
  scope:
    displayName: Scope
  level:
    displayName: Level
  status:
    displayName: Status
  added:
    displayName: Added
  maturity:
    displayName: Maturity
  confidence:
    displayName: Confidence
  support:
    displayName: Support
  recurrences:
    displayName: Recurrences
  blocks:
    displayName: Guard blocks
  overrides:
    displayName: Overrides
  last_evidence:
    displayName: Last evidence
  review:
    displayName: Review
views:
  - type: table
    name: Proposed
    filters:
      and:
        - 'status == "proposed"'
    order:
      - file.name
      - rule
      - scope
      - added
    sort:
      - property: added
        direction: DESC
  - type: table
    name: Needs review
    filters:
      and:
        - 'status == "active"'
        - file.hasProperty("review")
    order:
      - file.name
      - review
      - maturity
      - confidence
      - recurrences
      - overrides
  - type: table
    name: Active
    filters:
      and:
        - 'status == "active"'
    groupBy:
      property: scope
      direction: ASC
    order:
      - file.name
      - rule
      - level
      - maturity
      - confidence
      - support
      - recurrences
      - blocks
      - last_evidence
  - type: table
    name: Enforced
    filters:
      and:
        - 'status == "active"'
        - 'level == "block"'
    order:
      - file.name
      - rule
      - scope
      - blocks
  - type: table
    name: Retired
    filters:
      and:
        - 'status == "retired"'
    order:
      - file.name
      - rule
      - scope
      - retire_when
