filters:
  and:
    - file.inFolder("Sessions")
    - 'type == "session"'
properties:
  provider:
    displayName: Tool
  user_turns:
    displayName: Turns
  tool_calls:
    displayName: Tool calls
  cost_usd:
    displayName: Cost (USD)
views:
  - type: table
    name: Recent
    filters:
      and:
        - 'kind == "main"'
        - 'entrypoint != "sdk-cli"'
        - 'entrypoint != "codex_exec"'
        - 'entrypoint != "requirements_forum"'
    order:
      - started
      - provider
      - project
      - file.name
      - user_turns
      - model
      - effort
    sort:
      - property: started
        direction: DESC
    limit: 100
  - type: table
    name: By project
    filters:
      and:
        - 'kind == "main"'
        - 'entrypoint != "sdk-cli"'
        - 'entrypoint != "codex_exec"'
        - 'entrypoint != "requirements_forum"'
    groupBy:
      property: project
      direction: ASC
    order:
      - started
      - provider
      - file.name
      - user_turns
    sort:
      - property: started
        direction: DESC
  - type: table
    name: Workers
    filters:
      and:
        - 'kind == "main"'
        - or:
            - 'entrypoint == "sdk-cli"'
            - 'entrypoint == "codex_exec"'
    order:
      - started
      - provider
      - project
      - file.name
      - model
      - effort
      - cost_usd
    sort:
      - property: started
        direction: DESC
    limit: 100
  - type: table
    name: Subagents
    filters:
      and:
        - 'kind == "subagent"'
    order:
      - started
      - provider
      - title
      - file.name
      - parent
    sort:
      - property: started
        direction: DESC
    limit: 100
