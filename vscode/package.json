{
  "name": "ax-sessions",
  "displayName": "ax sessions",
  "description": "Every Claude Code and Codex session ax sees, in a sidebar, each one opening as a tab you can write to.",
  "version": "0.2.0",
  "publisher": "ax-local",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/EssenceSentry/agent-skills"
  },
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:ax.session",
    "onCustomEditor:ax.sessionEditor"
  ],
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "axPanel",
          "title": "ax",
          "icon": "media/ax-mark.svg"
        }
      ]
    },
    "views": {
      "axPanel": [
        {
          "id": "ax.panel",
          "type": "webview",
          "name": "ax",
          "icon": "media/ax-mark.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "ax.newSession",
        "title": "New Session",
        "category": "ax",
        "icon": "$(add)"
      },
      {
        "command": "ax.search",
        "title": "Search Past Sessions",
        "category": "ax",
        "icon": "$(search)"
      },
      {
        "command": "ax.searchTab",
        "title": "Search in a Tab",
        "category": "ax"
      },
      {
        "command": "ax.closeOffScreen",
        "title": "Close Session Tabs Not on Screen",
        "category": "ax",
        "icon": "$(close-all)"
      },
      {
        "command": "ax.share",
        "title": "Share ax Through Cloudflare",
        "category": "ax",
        "icon": "$(live-share)"
      },
      {
        "command": "ax.sharing",
        "title": "Shared: Copy the Link or Stop Sharing",
        "category": "ax",
        "icon": "$(radio-tower)"
      },
      {
        "command": "ax.refresh",
        "title": "Refresh Sessions",
        "category": "ax",
        "icon": "$(refresh)"
      },
      {
        "command": "ax.openSession",
        "title": "Open Session",
        "category": "ax"
      },
      {
        "command": "ax.changesThisTurn",
        "title": "Show Changes This Turn",
        "category": "ax",
        "icon": "$(diff)"
      },
      {
        "command": "ax.changesSinceCommit",
        "title": "Show Changes Since the Last Commit",
        "category": "ax",
        "icon": "$(git-compare)"
      },
      {
        "command": "ax.openUsage",
        "title": "Show Usage",
        "category": "ax"
      }
    ],
    "icons": {
      "ax-claude": {
        "description": "Claude",
        "default": {
          "fontPath": "media/ax-icons.woff",
          "fontCharacter": "\\E001"
        }
      },
      "ax-codex": {
        "description": "Codex",
        "default": {
          "fontPath": "media/ax-icons.woff",
          "fontCharacter": "\\E002"
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "ax.search",
          "when": "view == ax.panel",
          "group": "navigation@0"
        },
        {
          "command": "ax.share",
          "when": "view == ax.panel && !ax.shared",
          "group": "navigation@1"
        },
        {
          "command": "ax.sharing",
          "when": "view == ax.panel && ax.shared",
          "group": "navigation@1"
        },
        {
          "command": "ax.closeOffScreen",
          "when": "view == ax.panel",
          "group": "tabs@1"
        }
      ],
      "commandPalette": [
        {
          "command": "ax.openSession",
          "when": "false"
        },
        {
          "command": "ax.changesThisTurn",
          "when": "(activeWebviewPanelId == 'ax.session' || activeCustomEditorId == 'ax.sessionEditor')"
        },
        {
          "command": "ax.changesSinceCommit",
          "when": "(activeWebviewPanelId == 'ax.session' || activeCustomEditorId == 'ax.sessionEditor')"
        },
        {
          "command": "ax.share",
          "when": "!ax.shared"
        },
        {
          "command": "ax.sharing",
          "when": "ax.shared"
        }
      ],
      "editor/title": [
        {
          "command": "ax.changesThisTurn",
          "when": "(activeWebviewPanelId == 'ax.session' || activeCustomEditorId == 'ax.sessionEditor')",
          "group": "navigation@1"
        },
        {
          "command": "ax.changesSinceCommit",
          "when": "(activeWebviewPanelId == 'ax.session' || activeCustomEditorId == 'ax.sessionEditor')",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "ax",
      "properties": {
        "ax.server": {
          "type": "string",
          "default": "http://127.0.0.1:8765",
          "description": "The local ax app (`ax serve`) that lists the sessions and drives them."
        },
        "ax.notifications": {
          "type": "boolean",
          "default": true,
          "description": "Show a notification when a session starts waiting for you, for an approval or a question."
        },
        "ax.sendKey": {
          "type": "string",
          "enum": [
            "enter",
            "modEnter"
          ],
          "default": "enter",
          "description": "Send with Enter or Cmd/Ctrl+Enter. Cmd/Ctrl+Shift+Enter queues a task."
        },
        "ax.autoContext": {
          "type": "boolean",
          "default": true,
          "description": "Show the current editor file and selection as removable message context."
        },
        "ax.chatFontFamily": {
          "type": "string",
          "default": "",
          "description": "Chat font family; empty inherits the host font."
        },
        "ax.chatFontSize": {
          "type": "number",
          "minimum": 10,
          "maximum": 28,
          "default": 14,
          "description": "Chat text size in pixels."
        },
        "ax.codeFontSize": {
          "type": "number",
          "minimum": 9,
          "maximum": 24,
          "default": 12,
          "description": "Code text size in pixels."
        },
        "ax.reviewMode": {
          "type": "string",
          "enum": [
            "inline",
            "detached"
          ],
          "default": "inline",
          "description": "Preferred display for workspace change review."
        }
      }
    },
    "keybindings": [
      {
        "command": "ax.search",
        "key": "ctrl+alt+s",
        "mac": "ctrl+cmd+s"
      }
    ],
    "customEditors": [
      {
        "viewType": "ax.sessionEditor",
        "displayName": "ax session",
        "selector": [
          {
            "filenamePattern": "*.axsession"
          }
        ],
        "priority": "option"
      }
    ]
  },
  "scripts": {
    "build:page": "npm --prefix ../ui run build:vscode",
    "icons": "uv run --no-project --with fonttools --with skia-pathops python scripts/icons.py",
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --outfile=dist/extension.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "biome check && tsc --noEmit && vitest run",
    "package": "npm run icons && npm run build:page && npm run build && vsce package --no-dependencies --skip-license --out ax-sessions.vsix",
    "install-local": "npm run package && node scripts/install.mjs ax-sessions.vsix",
    "lint": "biome check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^24",
    "@types/vscode": "1.134.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "typescript": "~6.0.2",
    "vitest": "^5.0.5"
  }
}
