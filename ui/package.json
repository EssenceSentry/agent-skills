{
  "name": "ax-app",
  "private": true,
  "version": "0.0.0",
  "description": "The ax app: what waits for you, Claude and Codex usage, jobs, conversations and the vault's notes.",
  "type": "module",
  "workspaces": [
    "theme"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/stamp.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "biome check",
    "fix": "biome check --write",
    "check": "node scripts/check.mjs",
    "test": "vitest run",
    "verify": "biome check && tsc -b && node scripts/check-colours.mjs src && vitest run"
  },
  "dependencies": {
    "@atelier/theme": "*",
    "@base-ui/react": "^1.9.0",
    "@observablehq/plot": "^0.6.17",
    "@tailwindcss/vite": "^4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "playwright": "1.63.0",
    "typescript": "~6.0.2",
    "vite": "^8",
    "vitest": "^5.0.5"
  }
}
